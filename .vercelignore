# Archivos que nunca deben subirse al build de Vercel.
# (El bundle de la funcion ademas los excluye via vercel.json > functions.excludeFiles)
.env
.env.*
.vercel
.sim
.diag*
*.log

# Material de origen: no lo necesita ni el build ni el runtime, y son ~31 MB de
# PNG/GIF maestros que alargarian el upload en cada despliegue.
design/
docs/
test/
sql/
