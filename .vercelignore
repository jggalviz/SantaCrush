# Archivos que nunca deben subirse al build de Vercel.
# (El bundle de la funcion ademas los excluye via vercel.json > functions.excludeFiles)
.env
.env.*
.vercel
.sim
.diag*
*.log

# Material de origen: no lo necesita ni el build ni el runtime, y son ~55 MB de
# PNG/GIF/MP3 maestros que alargarian el upload en cada despliegue.
#
# Las carpetas van ANCLADAS a la raiz (/design/, no design/). Gitignore
# aplica los patrones sin barra inicial a cualquier nivel del arbol, asi que
# slot/ se llevaba por delante public/src/assets/slot/, que es justo el arte
# que descarga el tablero: los once simbolos respondian 404 en produccion y la
# rejilla caia al emoji de reserva. Lo vigila test/deploymentConfig.test.js.
/design/
/docs/
/test/
/sql/
# Arte fuente y audio original (solo lo usan scripts/build-santa-masters.js y scripts/import-slot-art.js).
/desk/
/movil/
/slot/
/sonidos/
SANTA-CRUSH-LOGO-ANIMADO.gif
Victoria navideña con mono y regalos.png
